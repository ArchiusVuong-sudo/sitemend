# Copy to .env (optional). Every value here is a default or an example.

# Dashboard port and Django API port (both bind 127.0.0.1)
PORT=4124
API_PORT=14124

# Model for titles, descriptions and alt text
SITEMEND_MODEL=claude-sonnet-5-5
# SITEMEND_MODEL=claude-opus-5-5
# SITEMEND_MODEL=claude-haiku-5-5

# Force replay mode (recorded sessions, no login or key needed)
DEMO_REPLAY=0

# Live mode uses the local Claude Code login. Without one, set an API key here.
ANTHROPIC_API_KEY=

# Model sessions at once and the timeout for each
SITEMEND_MAX_SESSIONS=3
SITEMEND_SESSION_TIMEOUT_S=180

# Where SQLite and the Celery broker files live (default: ./var)
# SITEMEND_VAR_DIR=./var
